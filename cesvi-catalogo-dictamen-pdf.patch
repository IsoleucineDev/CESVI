+  | "caravan" | "container" | "user" | "paw" | "droplet" | "droplets" | "bone" | "route"
+  | "footprints" | "hammer" | "package" | "glass" | "fuel" | "gem";
+
+export type ElementDefaults = {
+  massKg?: number;
+  lengthM?: number;
+  widthM?: number;
+  areaM2?: number;
+  frictionMu?: number;
+  note?: string;
+};
+
+export type CatalogItem = {
+  id: string;
+  category: CatalogCategory;
+  group: string;
+  label: string;
+  detail: string;
+  icon: IconKey;
+  tone: CatalogTone;
+  defaults: ElementDefaults;
+};
+
+export type SceneElement = {
+  uid: string;
+  catalogId: string;
+  label: string;
+  group: string;
+  category: CatalogCategory;
+  tone: CatalogTone;
+  scene: string;
+  defaults: ElementDefaults;
+};
